APP_ENV=dev
VENDURE_SERVER_PORT=3001
SUPERADMIN_USERNAME=superadmin
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=

# Put your own values in .env.local (loaded first, gitignored), not here.
# Neon: designaustria-shop-database, your local branch. Direct (non-pooler) connection string.
# The WordPress migration scripts refuse it unless --allow-remote; locally they use the app's shop-db
# (postgres://vendure:vendure@127.0.0.1:5434/vendure, see designaustria-app/migration/wordpress/README.md).
DATABASE_URL=
COOKIE_SECRET=
SUPERADMIN_PASSWORD=
